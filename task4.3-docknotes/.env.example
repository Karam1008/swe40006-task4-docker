# Copy to .env and edit. .env is git-ignored and excluded from the image.
DOCKERHUB_USER=your-dockerhub-username
APP_VERSION=1.0.0
APP_ENV=production
MAX_NOTES=25
# :80 for HTTP only, or <public-ip-with-dashes>.sslip.io for automatic HTTPS
SITE_ADDRESS=:80
# Host ports (change HTTP_PORT to e.g. 8081 if port 80 is already in use locally)
HTTP_PORT=80
HTTPS_PORT=443
